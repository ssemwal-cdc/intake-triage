{
  "defaultBranch": "main",
  "kinds": [
    {
      "id": "decision",
      "folder": "docs/decisions",
      "filePattern": "D[0-9]*.md",
      "prefix": "D",
      "idTemplate": "{prefix}{n}",
      "pendingRegex": "^id:[ \\t]*pending[ \\t]*$",
      "location": "frontmatter"
    }
  ],
  "merge": {
    "method": "merge",
    "deadlineMinutes": 20,
    "deleteBranch": true
  }
}
